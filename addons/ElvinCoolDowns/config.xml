	<!-- Config CheckButton -->
	<CheckButton name="ElvinCoolDowns_Config_CheckButton" inherits="SendMailRadioButtonTemplate" virtual="true">
		<Size>
			<AbsDimension x="20" y="20" />
		</Size>
		<Scripts>
			<OnClick>ElvinCoolDowns.Config.General:onClick(self)</OnClick>
		</Scripts>
	</CheckButton>

	<!-- Config FontString -->
	<FontString name="ElvinCoolDowns_Config_FontString" inherits="GameFontNormal" justifyH="LEFT" justifyV="TOP" virtual="true">
