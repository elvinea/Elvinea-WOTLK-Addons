			<AbsDimension x="185" y="5" />
		</Size>
	</FontString>
	<FontString name="ElvinCoolDowns_Config_HelpFontString" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP" virtual="true" wordwrap="true">
		<Size>
			<AbsDimension x="185" y="0" />
		</Size>
	</FontString>

	<!-- Spells Check Buttons -->
	<CheckButton name="ElvinCoolDowns_SpellsCheckButoon" inherits="SendMailRadioButtonTemplate" virtual="true">
		<Size x="18" y="18" />
		<Scripts>
			<OnEnter>
				local parent = self:GetParent();
				parent.hovered = true;
				parent:LockHighlight();
			</OnEnter>
			<OnLeave>
				local parent = self:GetParent();
				parent.hovered = false;
				parent:UnlockHighlight();
			</OnLeave>
		</Scripts>
		<Anchors>
			<Anchor point="LEFT" relativeTo="$parentSpellName" relativePoint="RIGHT" x="65" y="0" />
		</Anchors>
	</CheckButton>

